{
  "manifest_version": 3,
  "name": "PLAYER ONE — Amizone bridge",
  "version": "1.0.0",
  "description": "Keeps PLAYER ONE's attendance and timetable current by fetching Amizone from this browser, using the session already signed in here.",

  "permissions": ["alarms", "storage", "cookies"],

  "host_permissions": [
    "https://s.amizone.net/*",
    "https://xroynvkzephebhcztvfo.supabase.co/*"
  ],

  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "PLAYER ONE — Amizone bridge", "default_popup": "options.html" }
}
